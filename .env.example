# 复制为 .env 后修改（./install.sh 会交互生成）。process-compose 启动时自动加载仓库根目录的 .env。

# 上游 SOCKS5 服务器，UDP 代理需要其支持 UDP ASSOCIATE
SOCK_SERVER=127.0.0.1
SOCK_PORT=7070

# redsocks 本地监听端口：TCP（REDIRECT 目标）和 UDP（TPROXY 目标）
PROXY_PORT=12345
UDP_PROXY_PORT=10053

# redsocks 运行时使用的组，iptables 按该组排除 redsocks 自身流量
PROXY_GROUP=redsocks
