[Unit]
Description=Transparent redirector of any TCP connection to proxy using your firewall

[Service]
Type=forking
PIDFile=/run/redsocks/redsocks.pid
User=redsocks
Group=redsocks
RuntimeDirectory=redsocks
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ExecStart=/usr/bin/redsocks -c /etc/redsocks/redsocks.conf -p /run/redsocks/redsocks.pid
ExecStopPost=/bin/rm -f /run/redsocks/redsocks.pid
ExecStopPost=-+/usr/sbin/iptables -t nat -D PREROUTING -p tcp -j REDSOCKS_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t nat -F REDSOCKS_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t nat -X REDSOCKS_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t nat -D OUTPUT -p tcp -j REDSOCKS_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t nat -F REDSOCKS_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t nat -X REDSOCKS_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t nat -F REDSOCKS_TCP
ExecStopPost=-+/usr/sbin/iptables -t nat -X REDSOCKS_TCP
ExecStopPost=-+/usr/sbin/iptables -t filter -D INPUT -p tcp -j REDSOCKS_INPUT
ExecStopPost=-+/usr/sbin/iptables -t filter -D INPUT -p udp -j REDSOCKS_INPUT
ExecStopPost=-+/usr/sbin/iptables -t filter -F REDSOCKS_INPUT
ExecStopPost=-+/usr/sbin/iptables -t filter -X REDSOCKS_INPUT
ExecStopPost=-+/usr/sbin/iptables -t mangle -D OUTPUT -p udp -j REDSOCKS_UDP_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t mangle -D PREROUTING -p udp -j REDSOCKS_UDP_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t mangle -F REDSOCKS_UDP_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t mangle -X REDSOCKS_UDP_OUTPUT
ExecStopPost=-+/usr/sbin/iptables -t mangle -F REDSOCKS_UDP_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t mangle -X REDSOCKS_UDP_PREROUTING
ExecStopPost=-+/usr/sbin/iptables -t mangle -F REDSOCKS_UDP_PROXY
ExecStopPost=-+/usr/sbin/iptables -t mangle -X REDSOCKS_UDP_PROXY
ExecStopPost=-+/usr/sbin/ip -4 rule del fwmark 0x2333 lookup 10053
ExecStopPost=-+/usr/sbin/ip -4 route del local 0.0.0.0/0 dev lo table 10053
Restart=on-abort

[Install]
WantedBy=multi-user.target
